# ==============================================================================
# Enterprise Knowledge Navigator - Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="Enterprise Knowledge Navigator"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Security & Secrets
# In production (ENVIRONMENT=production), SECRET_KEY MUST be at least 32 characters and non-default.
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Demo accounts (admin, worker, analyst) are enabled in dev; set to false in production for zero-trust
ENABLE_DEMO_ACCOUNTS=true

# CORS Configuration
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080"

# Storage Paths
DATA_DIR="data"
RAW_DOCS_DIR="data/raw"
PROCESSED_DOCS_DIR="data/processed"
VECTOR_STORE_DIR="data/vector_store"
GRAPH_STORE_DIR="data/graph_store"
LOG_DIR="logs"

# Database Configuration (SQLite / Persistent Storage)
DATABASE_URL="sqlite:///./data/knowledge_navigator.db"

# LLM & Embedding Settings (To be configured in upcoming sprints)
LLM_PROVIDER="groq" # options: groq, gemini, ollama
LLM_MODEL="llama-3.3-70b-versatile"
EMBEDDING_PROVIDER="huggingface" # options: huggingface, openai, ollama
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Optional API Keys (Leave blank to use built-in Zero-Key Extractive Synthesis)
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Optional SMTP Email Configuration for Password Recovery OTP (Leave empty for secure local console mode)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@eknavigator.com"
SMTP_TLS=true
